{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./client/src/*"] },
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["client/src"]
}
