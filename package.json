{
  "name": "perpetual-ci-cd",
  "version": "0.1.0",
  "description": "Rebuild a local twin of your app on every push, replay approved business journeys, and report a GitHub check.",
  "keywords": [
    "ci-cd",
    "e2e-testing",
    "playwright",
    "ai-agents",
    "docker-compose",
    "github-actions",
    "preview-environments",
    "local-first"
  ],
  "homepage": "https://github.com/glennlzl/Perpetual-CI-CD#readme",
  "bugs": {
    "url": "https://github.com/glennlzl/Perpetual-CI-CD/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glennlzl/Perpetual-CI-CD.git"
  },
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "perpetual": "./src/cli.mjs"
  },
  "scripts": {
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node src/cli.mjs serve",
    "test": "node --test test/*.test.mjs",
    "test:browser": "uv run --project integrations/browser-use --frozen python -m unittest discover -s integrations/browser-use -p 'test_*.py'",
    "scan": "node src/cli.mjs scan"
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0"
  }
}
