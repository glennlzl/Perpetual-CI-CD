{
  "name": "perpetual-ci-cd",
  "version": "0.1.0",
  "private": true,
  "description": "Rebuild a local twin of your app on every push, replay approved business journeys, and report a GitHub check.",
  "keywords": [
    "ci-cd",
    "e2e-testing",
    "playwright",
    "ai-agents",
    "docker-compose",
    "github-actions",
    "preview-environments",
    "local-first"
  ],
  "homepage": "https://github.com/glennlzl/Perpetual-CI-CD#readme",
  "bugs": {
    "url": "https://github.com/glennlzl/Perpetual-CI-CD/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glennlzl/Perpetual-CI-CD.git"
  },
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.12"
  },
  "bin": {
    "perpetual": "./src/cli.ts"
  },
  "scripts": {
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node src/cli.ts serve",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "pretest": "npm run typecheck && npm run build",
    "test": "node --test test/*.test.ts",
    "test:browser": "uv run --project integrations/browser-use --frozen python -m unittest discover -s integrations/browser-use -p 'test_*.py'",
    "scan": "node src/cli.ts scan"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@playwright/test": "1.63.0",
    "@xyflow/react": "^12.12.0",
    "ai": "7.0.116",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "diff": "^9.0.0",
    "get-nonce": "^1.0.1",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "1.9.0",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
