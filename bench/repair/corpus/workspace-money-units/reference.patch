+    total += unit * qty;
+    return `${qty} × ${sku} @ ${format(unit, currency)}  ${format(unit * qty, currency)}`;
+  });
   return [`Receipt ${number}`, ...rows, `Total  ${format(total, currency)}`].join('\n');
 }
