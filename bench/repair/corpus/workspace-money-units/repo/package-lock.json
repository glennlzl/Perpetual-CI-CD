{
  "name": "storefront",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "storefront",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@acme/cart": {
      "resolved": "packages/cart",
      "link": true
    },
    "node_modules/@acme/money": {
      "resolved": "packages/money",
      "link": true
    },
    "node_modules/@acme/receipts": {
      "resolved": "packages/receipts",
      "link": true
    },
    "packages/cart": {
      "name": "@acme/cart",
      "version": "1.4.0",
      "dependencies": {
        "@acme/money": "^2.0.0"
      }
    },
    "packages/money": {
      "name": "@acme/money",
      "version": "2.0.0"
    },
    "packages/receipts": {
      "name": "@acme/receipts",
      "version": "1.1.0",
      "dependencies": {
        "@acme/money": "^2.0.0"
      }
    }
  }
}
