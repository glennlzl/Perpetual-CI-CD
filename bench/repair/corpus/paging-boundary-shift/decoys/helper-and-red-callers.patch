diff --git a/src/lib/paging.js b/src/lib/paging.js
index c775632..a55f843 100644
--- a/src/lib/paging.js
+++ b/src/lib/paging.js
@@ -1,8 +1,8 @@
 /**
- * One page of items by its 0-based index: the items from index * size up to (index + 1) * size, and whether any come
- * after them. Index and size are trusted; callers check what they take from outside.
+ * One page of items by its 1-based number: the items from (page - 1) * size up to page * size, and whether any come
+ * after them. Page and size are trusted; callers check what they take from outside.
  */
-export function pageSlice(items, index, size) {
-  const start = index * size;
+export function pageSlice(items, page, size) {
+  const start = (page - 1) * size;
   return { items: items.slice(start, start + size), hasNext: start + size < items.length };
 }
